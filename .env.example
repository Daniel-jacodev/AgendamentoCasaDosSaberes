# Desenvolvimento local: substitua as tres senhas antes de iniciar.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-por-uma-senha-forte
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=troque-por-outra-senha-forte
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=http://localhost:8080
KEYCLOAK_SERVER_URL=http://localhost:8080/
KEYCLOAK_REALM=proj-social-ufc
KEYCLOAK_CLIENT_ID=proj-social-backend
KEYCLOAK_CLIENT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional, quando a URL interna difere do emissor publico:
# KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/proj-social-ufc

# PostgreSQL da aplicacao (separado do banco do Keycloak).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agendamento
DB_USER=agendamento
DB_PASSWORD=troque-por-uma-senha-do-banco
